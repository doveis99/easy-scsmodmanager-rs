{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Easy SCS Mod Manager",
  "identifier": "io.github.doveis99.easy-scsmodmanager-rs",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Easy SCS Mod Manager",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false,
        "backgroundColor": "#14171c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "easy-scsmodmanager-rs",
    "copyright": "GPL-3.0-or-later. Rust rewrite of Switch-Bros/easy-scsmodmanager.",
    "shortDescription": "Mod and load-order manager for ETS2 and ATS"
  }
}
