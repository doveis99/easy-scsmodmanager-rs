{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Easy SCS Mod Manager",
  "identifier": "io.github.doveis99.easy-scsmodmanager-rs",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Easy SCS Mod Manager",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "easy-scsmodmanager-rs",
    "copyright": "GPL-3.0-or-later. Rust rewrite of Switch-Bros/easy-scsmodmanager.",
    "category": "Utility",
    "shortDescription": "Mod and load-order manager for ETS2 and ATS",
    "longDescription": "Scans the mods of Euro Truck Simulator 2 and American Truck Simulator, groups the load order, flags conflicts and writes it back to the profile with a backup.",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
